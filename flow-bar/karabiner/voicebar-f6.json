{
  "description": "VoiceBar: F6 hold-to-record and Shift+F6 re-paste via local socket",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "f6"
      },
      "to": [
        {
          "shell_command": "/usr/bin/python3 -c 'import json,socket; s=socket.socket(socket.AF_UNIX); s.connect(\"/tmp/voicelayer.sock\"); s.sendall((json.dumps({\"type\":\"control\",\"command\":\"start-recording\"})+\"\\n\").encode()); s.close()'"
        }
      ],
      "to_after_key_up": [
        {
          "shell_command": "/usr/bin/python3 -c 'import json,socket; s=socket.socket(socket.AF_UNIX); s.connect(\"/tmp/voicelayer.sock\"); s.sendall((json.dumps({\"type\":\"control\",\"command\":\"stop-recording\"})+\"\\n\").encode()); s.close()'"
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "f6",
        "modifiers": {
          "mandatory": ["shift"]
        }
      },
      "to": [
        {
          "shell_command": "/usr/bin/python3 -c 'import json,socket; s=socket.socket(socket.AF_UNIX); s.connect(\"/tmp/voicelayer.sock\"); s.sendall((json.dumps({\"type\":\"control\",\"command\":\"paste-last-transcript\"})+\"\\n\").encode()); s.close()'"
        }
      ]
    }
  ]
}
