<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.voicelayer.voicebar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/VoiceBar.app/Contents/MacOS/VoiceBar</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Only restart on crash (non-zero exit), NOT on clean Quit.
         Previous KeepAlive:true caused Quit to respawn immediately. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Rendered by scripts/install-voicebar-autostart.sh: launchd does not
         expand $HOME inside a plist string, so the absolute path is baked in at
         install time. These are VoiceBar's own logs and live under the user's
         home at mode 600 -- /tmp is world-readable and predictable, and this
         file once held a keystroke log (fixed 2026-09-06). -->
    <key>StandardOutPath</key>
    <string>__VOICEBAR_LOG_DIR__/voicebar.log</string>

    <key>StandardErrorPath</key>
    <string>__VOICEBAR_LOG_DIR__/voicebar-err.log</string>
</dict>
</plist>
